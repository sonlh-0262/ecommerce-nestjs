# Application
NODE_ENV=development
PORT=3000
APP_NAME=E-commerce API

# API
API_PREFIX=api/v1
SWAGGER_PATH=docs
SWAGGER_ENABLED=true

# i18n - supported languages: en, vi
FALLBACK_LANGUAGE=en

# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ecommerce
DB_SCHEMA=public
DB_SSL=false
DB_LOGGING=false

# Redis
# REDIS_DB is the logical database *index* Redis keeps this app's keys in, not a
# database name. A Redis server ships with 16 of them, numbered 0-15, and 0 is
# the default one - change it only to share a server between apps.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=ecommerce:

# Authentication
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d
JWT_ISSUER=ecommerce-api
BCRYPT_SALT_ROUNDS=10

# Rate limiting - default for every route, per client IP. TTL is in seconds.
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Mail (SMTP). The defaults point at the Mailpit container: open
# http://localhost:8025 to read what the app sends. MAIL_USER / MAIL_PASSWORD
# stay empty for Mailpit and are needed for a real relay.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@ecommerce.local
MAIL_FROM_NAME=Ecommerce
# Front-end origin the links in mail point at - no trailing slash.
APP_WEB_URL=http://localhost:3000

# Uploaded files (avatars). Relative paths resolve against the working directory.
STORAGE_ROOT=./storage

# Admin account created by `npm run console -- seed:admin`. Leave both empty in
# development to get admin@example.com / Password@123; production refuses to
# seed until both are set.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Host ports published by docker compose. Defaults are shifted off the usual
# 3000/5432/6379 so this stack can run beside the tutorial project.
API_HOST_PORT=3001
DEBUG_HOST_PORT=9230
DB_HOST_PORT=5433
REDIS_HOST_PORT=6381
MAILPIT_SMTP_HOST_PORT=1026
MAILPIT_UI_HOST_PORT=8025
