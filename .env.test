# Overrides loaded when NODE_ENV=test (the e2e suite). Only the keys that must
# differ from `.env` belong here - everything else falls through.
DB_DATABASE=ecommerce_test
DB_HOST=localhost
DB_PORT=5433
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_DB=1
REDIS_KEY_PREFIX=ecommerce-test:
MAIL_HOST=localhost
MAIL_PORT=1026
APP_WEB_URL=http://localhost:3000
STORAGE_ROOT=./tmp/test-storage
THROTTLE_TTL=60
THROTTLE_LIMIT=100
